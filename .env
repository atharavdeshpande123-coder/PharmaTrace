# =====================================================
# PharmaTrace — Environment Variables
# =====================================================
# Supabase project credentials (PostgreSQL database + Auth).
# Create a project at https://supabase.com and paste your values here.
# Vercel: set the same keys in Project Settings → Environment Variables.
# =====================================================

# Public anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SECRET. Server-side only (seeds, admin ops).
# NEVER prefix with NEXT_PUBLIC_ and NEVER commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string used by Prisma.
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# (Use the pooled connection on port 6543 for serverless deploys like Vercel.)
DATABASE_URL=

# JWT secret for signing the local PharmaTrace session JWT (optional —
# if omitted, falls back to a dev secret). Keep this long & random.
JWT_SECRET=
