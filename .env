# Local development — uses SQLite
# For production/Vercel: use PostgreSQL connection string
DATABASE_URL=file:/home/z/my-project/db/custom.db
JWT_SECRET=pharmatrace_demo_jwt_secret_change_in_production_2026
BLOCKCHAIN_MODE=local
NODE_ENV=development
PUBLIC_APP_URL=http://21.0.8.228:3000
PRISMA_CLIENT_ENGINE_TYPE=library

# === REAL DATA MODE ===
# When true, NO mock/demo pharmaceutical data is used.
# All drug information must come from real authoritative sources.
REAL_DATA_ONLY=true

# === openFDA API (U.S. drug information) ===
# Get a free API key at https://open.fda.gov/api/reference/
# Without a key, you can still use the API but with lower rate limits (40 requests/min).
OPENFDA_API_KEY=

# === CDSCO / SUGAM (India) ===
# CDSCO does not currently offer a public REST API.
# When an authorized API becomes available, configure it here.
CDSCO_API_URL=
CDSCO_API_KEY=

# === Authorized Pharmaceutical Data Provider ===
AUTHORIZED_PHARMA_API_URL=
AUTHORIZED_PHARMA_API_KEY=

# === EVM / Blockchain (Sepolia testnet) ===
RPC_URL=https://rpc.sepolia.org
CHAIN_ID=11155111
CONTRACT_ADDRESS=
