# =====================================================
# PharmaTrace — Environment Variables
# =====================================================
# Supabase project credentials (PostgreSQL database + Auth).
# Create a project at https://supabase.com and paste your values here.
# Vercel: set the same keys in Project Settings → Environment Variables.
# =====================================================

# Supabase project URL (public).
NEXT_PUBLIC_SUPABASE_URL=https://pbtpqqnuovtpsqjifnpw.supabase.co

# Supabase publishable/anon key (public, browser-safe).
# Newer Supabase projects name this "publishable key" (sb_publishable_...);
# older projects name it "anon key" (eyJ...). We read both env var names.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_mpf19hW5nbDBXcLjMv8VfA_9hz0Pnho
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_mpf19hW5nbDBXcLjMv8VfA_9hz0Pnho

# Service role key — SECRET. Server-side only (seeds, admin ops).
# Copy from Supabase Dashboard → Project Settings → API → service_role.
# ⚠️ Fill this in with your real service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string used by Prisma.
# ⚠️ Replace [YOUR-PASSWORD] with your actual Supabase database password
#    (the one you set when creating the project).
DATABASE_URL=postgresql://postgres.pbtpqqnuovtpsqjifnpw:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# JWT secret for signing the local PharmaTrace session JWT (legacy fallback).
JWT_SECRET=be2815eec891c447495d6121bdf89e16155977351cb2644618fd5025e8d190f8
